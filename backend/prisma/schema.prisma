// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// สร้างตารางสำหรับเก็บ Cache การค้นหา
model SearchCache {
  id        Int      @id @default(autoincrement())
  keyword   String   @unique // เก็บคำค้นหา (เช่น "Bang Sue")
  data      String   // เก็บข้อมูลร้านอาหารที่หาเจอเป็น JSON String เพื่อความง่าย
  createdAt DateTime @default(now())
}
